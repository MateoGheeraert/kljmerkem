---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SanityImage from '../components/SanityImage.astro';
import RichText from '../components/RichText.astro';
import { getContent } from '../lib/content';
import { eventGroup, eventCategory, formatDate } from '../lib/helpers.mjs';
const { settings: s, events } = await getContent();
const page = s.navigation.find(p => p.path === '/evenementen/')!;
const groups = ['recurring', 'upcoming', 'undated', 'past'];
---
<Layout title={`${page.title} | ${s.name}`} description={page.description}><PageHeader page={page} /><div class="container section page-content">
  {groups.map(group => { const items = events.filter(event => eventCategory(event) === group); if (group === 'upcoming') items.reverse(); return items.length > 0 && <section class="event-group"><h2 class="group-title">{s.labels[group]}</h2>{items.map(event => <article class="event-card"><div class="event-photo"><SanityImage image={event.image} alt={event.title} width={1000} /></div><div class="event-copy">{event.annualSchedule && <p class="event-schedule">{event.annualSchedule}</p>}{event.date && (group !== 'recurring' || eventGroup(event.date) === 'upcoming') && <time class="event-date" datetime={event.date}>{formatDate(event.date)}</time>}<h3>{event.title}</h3>{event.location && <p class="event-location">↗ {event.location}</p>}<RichText value={event.description} /></div></article>)}</section>; })}
</div></Layout>
