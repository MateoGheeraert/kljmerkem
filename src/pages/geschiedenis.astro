---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';
import SanityImage from '../components/SanityImage.astro';
import { getContent } from '../lib/content';
const { settings: s, history } = await getContent();
const page = s.navigation.find(p => p.path === '/geschiedenis/')!;
---
<Layout title={`${history.title} | ${s.name}`} description={page.description}><PageHeader page={{...page, title: history.title}} /><section class="container history section page-content"><Timeline blocks={history.content} />{history.images?.map(image => <SanityImage image={image} alt={history.title} width={1200} />)}</section></Layout>
