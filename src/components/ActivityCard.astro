---
import type { Activity } from '../lib/content';
import SanityImage from './SanityImage.astro';
interface Props { activity: Activity;  }
const { activity } = Astro.props;
---
<article class="activity-card">
  <div class:list={['card-image', { 'image-empty': !activity.image }]}><SanityImage image={activity.image} alt={activity.title} /></div>
  <div class="card-body"><h2>{activity.title}</h2>{activity.description && <p>{activity.description}</p>}</div>
</article>
